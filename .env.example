# Copy to backend/.env for local development (read automatically; real env vars win).
# ---- Backend (backend/) ----
APP_ENV=development                 # production enforces JWT_SECRET and secure cookies
DEMO_MODE=true                      # enables demo accounts list, fault injection, demo reset
DATABASE_URL=sqlite:///./placementos.db   # or postgresql://user:pass@host:5432/db
JWT_SECRET=                         # required in production; >= 32 random bytes
JWT_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
# AI for the Email Reader and Goal Planner agents (optional; without a key, rule-based reading is used).
LLM_PROVIDER=auto                   # auto | gemini | anthropic | none  (auto prefers Gemini when its key is set)
GEMINI_API_KEY=                     # from Google AI Studio (aistudio.google.com/apikey)
GEMINI_MODEL=gemini-3.8-flash       # any Gemini model your key can use
ANTHROPIC_API_KEY=                  # alternative: Claude
LLM_MODEL=claude-opus-5-5
MOCK_PORTAL_BASE_URL=http://127.0.0.1:8000/mock-portal
ALLOWED_DESTINATION_HOSTS=127.0.0.1,localhost
UPLOAD_TIMEOUT_SECONDS=8
UPLOAD_MAX_ATTEMPTS=3
AUTO_MIGRATE=false                  # true: run migrations (+ demo seed) on startup
DEMO_PASSWORD=Demo@2026             # password for the staff logins created by `seed` / Demo reset
SEED_PROFILE=institute              # institute = 120 students (backend/app/data/institute_students.csv), no drives
                                    # demo = synthetic hackathon dataset with sample drives (used by the tests)
INSTITUTION_NAME=Institute Placement Cell
# Students who get real email (everyone else has a demo address and their emails stay in the app):
REAL_STUDENT_EMAILS=                # e.g. 22CSE005:you@gmail.com,22IT018:friend@gmail.com,22ECE018:other@gmail.com
COMPANY_SENDERS=companytestmailone@gmail.com,companytestmailtwo@gmail.com,companytestmailthree@gmail.com

# Email: without SMTP_HOST, messages stay in the in-app local mailbox (Communications page).
SMTP_HOST=                          # e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                      # for Gmail, an App Password
SMTP_FROM=PlaceCrew <placements@example.edu>
SMTP_STARTTLS=true
PUBLIC_APP_URL=http://localhost:3000   # base of the personal links emailed to students

# Placement mailbox via Google sign-in (Gmail API). Once connected in Settings, company emails are read from it
# and every outgoing email is sent from it (SMTP is then not used). See docs/SETUP_GMAIL_GEMINI.md.
GOOGLE_CLIENT_ID=                   # OAuth client (Web application) from Google Cloud
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                # default: PUBLIC_APP_URL + /api/integrations/google/callback
INBOX_SUBJECT_FILTER=Campus Drive   # only emails whose subject contains this are read (empty = all)
INBOX_LOOKBACK_DAYS=30
# Alternative to Google sign-in: IMAP with an app password
INBOX_IMAP_HOST=                    # e.g. imap.gmail.com
INBOX_IMAP_USER=                    # defaults to SMTP_USER
INBOX_IMAP_PASSWORD=                # defaults to SMTP_PASSWORD

# Autopilot: background agents (Mailbox, Deadline, Reminder) run every N seconds.
AUTOPILOT=true
AUTOPILOT_INTERVAL_SECONDS=120

# ---- Frontend (frontend/) ----
BACKEND_URL=http://127.0.0.1:8000   # server-side only; used by Next.js rewrites
